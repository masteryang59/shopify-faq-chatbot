# Required
OPENAI_API_KEY=sk-...

# Optional: models
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: answers the model rates below this (0-1) go to a person instead
CONFIDENCE_THRESHOLD=0.7
RETRIEVAL_K=4

# Where handoff emails go
SUPPORT_EMAIL=support@driftwood-coffee.example
FROM_EMAIL=faq-bot@driftwood-coffee.example

# SMTP. Leave SMTP_HOST empty to write emails to ./outbox as .eml files.
# docker compose overrides these to use the bundled Mailpit inbox (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
DECODE_PAYLOAD=enabled
ROTATE_SECRET=enabled
DECODE_PAYLOAD=enabled